# ─────────────────────────────────────────────
# Smart Laundry Web — Environment Variables
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.
# ─────────────────────────────────────────────

# Base URL of the backend REST API (include the /api/v1 path prefix)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Public base URL of this frontend app (used for absolute links / OG tags)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# WebSocket endpoint for real-time driver task notifications
NEXT_PUBLIC_DRIVER_WS_URL=ws://localhost:8000/ws/drivers

# ─── Google Maps ──────────────────────────────
# Used for map rendering on order tracking and shop location pages
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── Firebase (Push Notifications) ───────────
# Obtain these values from the Firebase Console → Project Settings → Your Apps
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# VAPID key for Web Push — Firebase Console → Project Settings → Cloud Messaging
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_firebase_vapid_key
